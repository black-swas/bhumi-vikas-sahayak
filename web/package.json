{
  "name": "bhumi-vikas-sahayak-web",
  "version": "0.1.0",
  "description": "Counter-clerk web app for Bhumi Vikas Sahayak (prototype, not legal advice)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env VITE_MOCK_API=false react-router dev",
    "dev:mock": "npm run make-i18n && cross-env VITE_MOCK_API=true react-router dev",
    "build": "npm run make-i18n && react-router build",
    "build:mock": "npm run make-i18n && cross-env VITE_MOCK_API=true react-router build",
    "test": "npm run make-i18n && vitest run",
    "make-i18n": "node scripts/make-i18n-translations.cjs",
    "prelint": "npm run make-i18n",
    "lint": "npm run typecheck && eslint src && prettier --check \"src/**/*.{ts,tsx}\" && npm run check-translation-completeness",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "react-router typegen && tsc",
    "check-translation-completeness": "node scripts/check-translation-completeness.cjs",
    "gen:api": "node scripts/gen-api.mjs",
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@heroui/react": "2.8.10",
    "@react-router/node": "7.18.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.38.0",
    "i18next": "26.4.2",
    "lucide-react": "1.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "17.0.14",
    "react-router": "7.18.2",
    "tailwind-merge": "3.7.0",
    "tailwind-scrollbar": "4.0.2",
    "vite": "8.0.16",
    "zustand": "5.0.14",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.4",
    "@react-router/dev": "7.18.2",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vercel/react-router": "1.3.3",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss-prefix-selector": "2.1.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
